{
  "name": "modx-analyzer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "pnpm run lint:ts && pnpm run lint:rust",
    "lint:ts": "prettier --check . && pnpm -r run lint",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "pnpm run test:ts && pnpm run test:rust",
    "test:ts": "pnpm -r run test",
    "test:rust": "cargo test --workspace",
    "build": "pnpm run build:ts && pnpm run build:rust",
    "build:ts": "pnpm -r run build",
    "build:rust": "cargo build --workspace",
    "tauri": "tauri",
    "dev": "tauri dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.1",
    "prettier": "^3.8.1"
  }
}
