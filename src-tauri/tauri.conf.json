{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MODX Analyzer",
  "version": "0.1.0",
  "identifier": "com.foxandxss.modx-analyzer",
  "build": {
    "frontendDist": "../ui/dist/ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm --filter ui run start",
    "beforeBuildCommand": "pnpm --filter ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MODX Analyzer",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
